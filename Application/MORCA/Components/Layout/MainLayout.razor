@inherits LayoutComponentBase
@using MORCA.Services
@inject MsiDatabaseService MsiService

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Toggle navigation menu" />
        <MudText Typo="Typo.h6" Class="ml-3">MORCA</MudText>
        
        @if (_isOpen)
        {
            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="ml-4">
                📦 @Path.GetFileName(MsiService.FilePath)
            </MudText>
        }
        
        <MudSpacer />
        
        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenMsiFile">
            Open
        </MudButton>
        
        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Close" OnClick="CloseMsiFile" Disabled="@(!_isOpen)">
            Close
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Variant="@DrawerVariant.Responsive" Width="220px">
        <NavMenu IsOpen="@_isOpen" />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isOpen;
    private System.Timers.Timer? _stateCheckTimer;

    protected override void OnInitialized()
    {
        _isOpen = MsiService.IsOpen;
        
        // Check service state every 500ms to detect changes
        _stateCheckTimer = new System.Timers.Timer(500);
        _stateCheckTimer.Elapsed += (s, e) => 
        {
            var newState = MsiService.IsOpen;
            if (newState != _isOpen)
            {
                _isOpen = newState;
                InvokeAsync(StateHasChanged);
            }
        };
        _stateCheckTimer.Start();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task OpenMsiFile()
    {
        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Select an MSI file",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.WinUI, new[] { ".msi" } }
                })
            });

            if (result != null)
            {
                MsiService.Open(result.FullPath, readOnly: true);
                _isOpen = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error opening file: {ex.Message}");
        }
    }

    private async Task CloseMsiFile()
    {
        if (MsiService.IsOpen)
        {
            MsiService.Close();
            _isOpen = false;
            StateHasChanged();
        }
        await Task.CompletedTask;
    }

    void IDisposable.Dispose()
    {
        _stateCheckTimer?.Stop();
        _stateCheckTimer?.Dispose();
    }
}
