@inherits LayoutComponentBase
@implements IDisposable
@using MORCA.Services
@inject MsiDatabaseService MsiService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Toggle navigation menu" />
        <MudText Typo="Typo.h6" Class="ml-3">MORCA</MudText>
        
        @if (MsiService.IsOpen)
        {
            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="ml-4">
                📦 @MsiService.DisplayName@(MsiService.IsDirty ? "*" : "")
            </MudText>
        }
        
        <MudSpacer />
        
        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.NoteAdd" OnClick="NewMsiFile">
            New
        </MudButton>

        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenMsiFile">
            Open
        </MudButton>
        
        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveMsiFile" Disabled="@(!(MsiService.IsDirty || MsiService.IsUntitled))">
            Save
        </MudButton>

        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.SaveAs" OnClick="SaveMsiFileAs" Disabled="@(!MsiService.IsOpen)">
            Save As
        </MudButton>

        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Close" OnClick="CloseMsiFile" Disabled="@(!MsiService.IsOpen)">
            Close
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" Variant="@DrawerVariant.Responsive" Width="220px">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized() => MsiService.StateChanged += OnMsiStateChanged;

    private void OnMsiStateChanged() => InvokeAsync(StateHasChanged);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task OpenMsiFile()
    {
        if (!await ConfirmDiscardChangesAsync()) return;

        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Select an MSI file",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.WinUI, new[] { ".msi" } },
                    // Android and Apple pickers filter by MIME type / UTI, and have no reliable one for .msi
                    { DevicePlatform.Android, new[] { "*/*" } },
                    { DevicePlatform.iOS, new[] { "public.data" } },
                    { DevicePlatform.MacCatalyst, new[] { "public.data" } }
                })
            });

            if (result != null)
            {
                MsiService.Open(result.FullPath, readOnly: true);
                Navigation.NavigateTo("msi-summaryinformation");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not open file: {ex.Message}", Severity.Error);
        }
    }

    private async Task NewMsiFile()
    {
        if (!await ConfirmDiscardChangesAsync()) return;

        try
        {
            MsiService.CreateUntitled();
            Navigation.NavigateTo("msi-summaryinformation");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not create MSI: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveMsiFile()
    {
        if (MsiService.IsUntitled)
        {
            await SaveMsiFileAs();
            return;
        }

        try
        {
            MsiService.Save();
            Snackbar.Add($"Saved {MsiService.DisplayName}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveMsiFileAs()
    {
        try
        {
            var bytes = MsiService.ReadAllBytes();
            using var stream = new MemoryStream(bytes);

            var result = await CommunityToolkit.Maui.Storage.FileSaver.Default.SaveAsync(MsiService.SuggestedFileName, stream);
            if (result.IsSuccessful)
            {
                MsiService.AdoptSavedFile(result.FilePath);
                Snackbar.Add($"Saved {MsiService.DisplayName}", Severity.Success);
            }
            else if (result.Exception is { } ex && !ex.Message.Contains("cancel", StringComparison.OrdinalIgnoreCase))
            {
                Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save: {ex.Message}", Severity.Error);
        }
    }

    private async Task CloseMsiFile()
    {
        if (await ConfirmDiscardChangesAsync())
            MsiService.Close();
    }

    /// <summary>
    /// If there are unsaved changes, asks whether to save them. Returns true when it is safe to
    /// replace or close the current database (nothing unsaved, saved, or the user chose Don't Save).
    /// </summary>
    private async Task<bool> ConfirmDiscardChangesAsync()
    {
        if (!MsiService.IsDirty) return true;

        var answer = await DialogService.ShowMessageBoxAsync(
            "Unsaved changes",
            $"Save changes to {MsiService.DisplayName}?",
            yesText: "Save",
            noText: "Don't Save",
            cancelText: "Cancel");

        if (answer is null) return false;          // Cancel
        if (answer == false) return true;          // Don't Save

        await SaveMsiFile();
        return !MsiService.IsDirty;                // false if the Save As dialog was cancelled or failed
    }

    public void Dispose() => MsiService.StateChanged -= OnMsiStateChanged;
}
