@using MORCA.Services
@inject MsiDatabaseService MsiService

<div @key="MsiService.IsOpen">
    <MudNavMenu>
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
        
        @if (MsiService.IsOpen)
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Class="px-4 mt-2">MSI Tools</MudText>
            <MudNavLink Href="msi-summary" Icon="@Icons.Material.Filled.Info">Summary</MudNavLink>
            <MudNavLink Href="msi-features" Icon="@Icons.Material.Filled.FolderSpecial">Features</MudNavLink>
            <MudNavLink Href="msi-custom-actions" Icon="@Icons.Material.Filled.Code">Custom Actions</MudNavLink>
            <MudNavLink Href="msi-tables" Icon="@Icons.Material.Filled.Edit">Tables</MudNavLink>
        }
    </MudNavMenu>
</div>
