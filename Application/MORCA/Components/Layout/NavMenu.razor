@implements IDisposable
@inject MORCA.Services.MsiDatabaseService MsiService

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

    @if (MsiService.IsOpen)
    {
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.caption" Class="px-4 mt-2">MSI Tools</MudText>
        <MudNavLink Href="msi-summaryinformation" Icon="@Icons.Material.Filled.Info">Summary Information </MudNavLink>
        <MudNavLink Href="msi-tables" Icon="@Icons.Material.Filled.Edit">Tables</MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => MsiService.StateChanged += OnMsiStateChanged;

    private void OnMsiStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => MsiService.StateChanged -= OnMsiStateChanged;
}
