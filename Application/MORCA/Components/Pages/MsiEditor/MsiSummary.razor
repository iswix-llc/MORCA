@page "/msi-summary"
@using MORCA.Services
@inject MsiDatabaseService MsiService

<PageTitle>MSI Summary - MORCA</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">MSI Summary</MudText>

@if (!MsiService.IsOpen)
{
    <MudAlert Severity="Severity.Warning">
        No MSI file is open. Click <strong>Open MSI</strong> in the top menu.
    </MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2" GutterBottom="true">File Information</MudText>
                <MudSimpleTable>
                    <tbody>
                        <tr>
                            <td style="width: 120px; font-weight: bold;">Path:</td>
                            <td>@(MsiService.FilePath ?? "(not saved yet)")</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;">Size:</td>
                            <td>@GetFileSize()</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;">Tables:</td>
                            <td>@_tableCount</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2" GutterBottom="true">Tables</MudText>
                @if (_tables != null)
                {
                    <MudTable Items="_tables" Hover="true" Dense="true">
                        <HeaderContent>
                            <MudTh>Table Name</MudTh>
                            <MudTh>Row Count</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Table Name">@context.Name</MudTd>
                            <MudTd DataLabel="Row Count">@context.RowCount</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private List<(string Name, int RowCount)>? _tables;
    private int _tableCount;

    protected override async Task OnInitializedAsync()
    {
        if (MsiService.IsOpen)
        {
            try
            {
                var tableNames = MsiService.GetTableNames();
                _tableCount = tableNames.Count;
                
                _tables = new List<(string, int)>();
                foreach (var table in tableNames)
                {
                    var rows = MsiService.GetTableRows(table);
                    _tables.Add((table, rows.Count));
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error loading summary: {ex.Message}");
            }
        }

        await Task.CompletedTask;
    }

    private string GetFileSize()
    {
        try
        {
            if (MsiService.FilePath is null) return "Not saved yet";
            var info = new FileInfo(MsiService.FilePath);
            return $"{info.Length:N0} bytes";
        }
        catch
        {
            return "Unknown";
        }
    }
}
