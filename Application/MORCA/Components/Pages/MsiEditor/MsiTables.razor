    // --- Find / Find Next across all tables ---
    private string? _findText;
    private string? _findStatus;
    private FindHit? _match;        // the cell highlighted now
    private FindHit? _firstMatch;   // first hit of this search; reaching it again means every match has been seen
    private bool _scrollToMatch;

    private void OnFindTextChanged(string? text)
    {
        _findText = text;
        ResetFind();
    }

    private void ResetFind()
    {
        _match = null;
        _firstMatch = null;
        _findStatus = null;
    }

    private async Task OnFindKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await FindNextAsync();
    }

    private Task FindNextAsync()
    {
        if (string.IsNullOrWhiteSpace(_findText) || _tables is not { Count: > 0 }) return Task.CompletedTask;

        try
        {
            var result = TableFinder.FindNext(_tables, LoadForFind, _findText, _selectedTable ?? _tables[0], _match);
            if (result is not { } hit)
            {
                ResetFind();
                _findStatus = "No matches found.";
                Snackbar.Add($"No matches found for \"{_findText}\".", Severity.Info);
                return Task.CompletedTask;
            }

            var wrapped = _firstMatch != null && hit == _firstMatch;
            _firstMatch ??= hit;

            if (hit.Table != _selectedTable) SelectTable(hit.Table, keepFind: true);
            _match = hit;
            _scrollToMatch = true;

            if (wrapped)
            {
                _findStatus = "No more matches found. Back at the first match.";
                Snackbar.Add("No more matches found. Back at the first match.", Severity.Info);
            }
            else
            {
                _findStatus = $"{hit.Table} › {hit.Column}, row {hit.Row + 1}";
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Search failed: {ex.Message}", Severity.Error);
        }

        return Task.CompletedTask;
    }

    private FindTableContent? LoadForFind(string table)
    {
        try
        {
            var columns = MsiService.GetTableColumns(table).Select(c => c.Name).ToList();
            return new FindTableContent(columns, MsiService.GetTableRows(table));
        }
        catch
        {
            return null; // a table that cannot be read is skipped
        }
    }

    private bool IsMatch(Dictionary<string, object?> row, string column) =>
        _match is { } m && m.Table == _selectedTable && m.Column == column &&
        _tableData is { } data && m.Row < data.Rows.Count && ReferenceEquals(data.Rows[m.Row], row);

    // True when the device has a touch screen (asked of the OS); decides whether the ⋮ button is shown.
    private readonly bool _hasTouch = TouchSupport.HasTouchScreen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToMatch) return;
        _scrollToMatch = false;
        try
        {
            await JS.InvokeVoidAsync("eval", "document.querySelector('.find-hit')?.scrollIntoView({ block: 'center', inline: 'nearest' })");
        }
        catch
        {
            // scrolling is a nicety; ignore if it is not available
        }
    }

    protected override void OnInitialized()
    {
        MsiService.StateChanged += OnMsiStateChanged;
        LoadTables();
    }

    private int _generation = -1;   // which opened database the table list was loaded for

    private void OnMsiStateChanged()
    {
        InvokeAsync(() =>
        {
            // The same database changing (first edit marks it dirty, saving) must not reset the table you are in.
            if (MsiService.IsOpen && _tables != null && _generation == MsiService.Generation)
            {
                StateHasChanged();
                return;
            }

            LoadTables();
            StateHasChanged();
        });
    }

    private void LoadTables()
    {
        _selectedTable = null;
        _tableData = null;
        _tables = MsiService.IsOpen ? MsiService.GetTableNames() : null;
        _generation = MsiService.Generation;

        if (_tables is { Count: > 0 })
        {
            SelectTable(_tables[0]);
        }
    }

    private async Task AddTableAsync()
    {
        try
        {
            // Offer the standard tables this database does not have yet.
            var existing = MsiService.GetTableNames();
            var available = StandardTables.Names
                .Where(name => !existing.Contains(name, StringComparer.OrdinalIgnoreCase))
                .ToList();
            if (available.Count == 0)
            {
                Snackbar.Add("This database already has every standard table.", Severity.Info);
                return;
            }

            var parameters = new DialogParameters<AddTableDialog> { { x => x.Tables, available } };
            var dialog = await DialogService.ShowAsync<AddTableDialog>("Add Table", parameters,
                new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
            var result = await dialog.Result;
            if (result is null || result.Canceled || result.Data is not List<string> chosen || chosen.Count == 0) return;

            var created = new List<string>();
            var failed = new List<string>();
            foreach (var name in chosen)
            {
                try
                {
                    MsiService.CreateTable(StandardTables.Get(name)!);
                    created.Add(name);
                }
                catch (Exception ex)
                {
                    failed.Add($"{name}: {ex.Message}");
                }
            }

            LoadTables();
            if (created.Count > 0) SelectTable(created[0]);

            if (failed.Count > 0)
                Snackbar.Add($"Added {created.Count}, {failed.Count} failed. {string.Join(" ", failed)}", Severity.Error);
            else
                Snackbar.Add($"Added {(created.Count == 1 ? $"table {created[0]}" : $"{created.Count} tables")}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not add tables: {ex.Message}", Severity.Error);
        }
    }

    private async Task AddCustomTableAsync()
    {
        var parameters = new DialogParameters<TableSchemaDialog>
        {
            { x => x.ExistingTables, MsiService.GetTableNames() }
        };
        var dialog = await DialogService.ShowAsync<TableSchemaDialog>("Table Schema", parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not MsiTableDefinition definition) return;

        try
        {
            MsiService.CreateTable(definition);
            // StateChanged (from MarkDirty) only fires on the first change, so reload explicitly.
            LoadTables();
            SelectTable(definition.Name);
            Snackbar.Add($"Created custom table {definition.Name}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not create custom table: {ex.Message}", Severity.Error);
        }
    }

    // The engine refuses to adjust or drop the system tables; _Validation is an ordinary table that may be dropped.
    private static readonly string[] SystemTables = { "_Tables", "_Columns", "_Streams", "_Storages" };

    private bool CanAdjustSelected => _selectedTable != null && !_selectedTable.StartsWith('_');

    private bool CanDropSelected => _selectedTable != null &&
        !SystemTables.Contains(_selectedTable, StringComparer.OrdinalIgnoreCase);

    private bool CanEditRows => CanDropSelected; // everything except the engine's system tables

    private async Task AddRowAsync()
    {
        if (_selectedTable == null) return;
        var tableName = _selectedTable;

        try
        {
            var parameters = new DialogParameters<RowEditDialog>
            {
                { x => x.Definition, MsiService.GetTableDefinition(tableName) }
            };
            var dialog = await DialogService.ShowAsync<RowEditDialog>($"Add row to {tableName}", parameters,
                new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialog.Result;
            if (result is null || result.Canceled || result.Data is not Dictionary<string, object?> values) return;

            MsiService.InsertRow(tableName, values);
            SelectTable(tableName);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not add row: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteRowAsync(Dictionary<string, object?> row)
    {
        if (_selectedTable == null) return;
        var tableName = _selectedTable;

        try
        {
            var definition = MsiService.GetTableDefinition(tableName);
            var keys = definition.Columns.Take(definition.PrimaryKeys).Select(c => c.Name).ToList();
            var keyValues = keys.ToDictionary(k => k, k => row.TryGetValue(k, out var v) ? v : null);

            var confirmed = await DialogService.ShowMessageBoxAsync(
                "Delete row",
                $"Delete the row {string.Join(", ", keys.Select(k => $"{k} = {keyValues[k]}"))} from {tableName}?",
                yesText: "Delete",
                cancelText: "Cancel");
            if (confirmed != true) return;

            MsiService.DeleteRow(tableName, keyValues);
            SelectTable(tableName);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not delete row: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportTablesAsync()
    {
        try
        {
            var parameters = new DialogParameters<ExportTablesDialog>
            {
                { x => x.Tables, MsiService.GetTableNames() }
            };
            var dialog = await DialogService.ShowAsync<ExportTablesDialog>("Export Tables", parameters,
                new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
            var result = await dialog.Result;
            if (result is null || result.Canceled || result.Data is not List<string> chosen || chosen.Count == 0) return;

            var folder = await CommunityToolkit.Maui.Storage.FolderPicker.Default.PickAsync(CancellationToken.None);
            if (!folder.IsSuccessful)
            {
                // Cancelling the picker is not an error.
                if (folder.Exception is { } pickError && !pickError.Message.Contains("cancel", StringComparison.OrdinalIgnoreCase))
                    Snackbar.Add($"Could not choose a folder: {pickError.Message}", Severity.Error);
                return;
            }

            MsiService.ExportTables(chosen, folder.Folder.Path);
            Snackbar.Add($"Exported {chosen.Count} table{(chosen.Count == 1 ? "" : "s")} to {folder.Folder.Path}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not export tables: {ex.Message}", Severity.Error);
        }
    }

    private async Task ImportTablesAsync()
    {
        try
        {
            var folder = await CommunityToolkit.Maui.Storage.FolderPicker.Default.PickAsync(CancellationToken.None);
            if (!folder.IsSuccessful)
            {
                if (folder.Exception is { } pickError && !pickError.Message.Contains("cancel", StringComparison.OrdinalIgnoreCase))
                    Snackbar.Add($"Could not choose a folder: {pickError.Message}", Severity.Error);
                return;
            }

            var path = folder.Folder.Path;
            if (path.Contains("://"))
                throw new NotSupportedException("This platform returned a folder that cannot be read directly.");

            var files = Directory.GetFiles(path, "*.idt");
            if (files.Length == 0)
            {
                Snackbar.Add("That folder has no .idt files.", Severity.Warning);
                return;
            }

            // Importing a table that is already there replaces it, so say which ones before doing it.
            var existing = MsiService.GetTableNames();
            var replacing = files
                .Select(MsiDatabaseService.ReadIdtTableName)
                .Where(name => name != null && existing.Contains(name, StringComparer.Ordinal))
                .ToList();
            if (replacing.Count > 0)
            {
                var confirmed = await DialogService.ShowMessageBoxAsync(
                    "Replace tables",
                    $"These tables already exist and will be replaced: {string.Join(", ", replacing)}.",
                    yesText: "Replace",
                    cancelText: "Cancel");
                if (confirmed != true) return;
            }

            var outcome = MsiService.ImportIdtFiles(files);

            LoadTables();
            if (outcome.Imported.Count > 0) SelectTable(outcome.Imported[0]);

            var notes = new List<string>();
            if (outcome.Skipped.Count > 0)
                notes.Add($"Skipped {string.Join(", ", outcome.Skipped)} (tables starting with an underscore cannot be imported)");
            notes.AddRange(outcome.Failed.Select(f => $"{f.File}: {f.Error}"));

            if (outcome.Failed.Count > 0)
                Snackbar.Add($"Imported {outcome.Imported.Count}, {outcome.Failed.Count} failed. {string.Join(" ", notes)}", Severity.Error);
            else if (outcome.Imported.Count == 0)
                Snackbar.Add($"Nothing imported. {string.Join(" ", notes)}", Severity.Warning);
            else
                Snackbar.Add($"Imported {outcome.Imported.Count} table{(outcome.Imported.Count == 1 ? "" : "s")}. {string.Join(" ", notes)}".TrimEnd(), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not import tables: {ex.Message}", Severity.Error);
        }
    }

    private async Task AdjustSchemaAsync()
