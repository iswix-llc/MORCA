    /// <summary>
    /// Orders rows by their primary key columns, in column order: numbers by value, text without regard to case,
    /// empty values first. Tables the editor cannot describe keep the order they have in the database.
    /// </summary>
    private static List<MsiGridRow> SortByPrimaryKey(IEnumerable<MsiGridRow> rows, MsiTableDefinition? definition)
    {
        var list = rows.ToList();
        if (definition == null || definition.PrimaryKeys < 1) return list;
        var keys = definition.Columns.Take(definition.PrimaryKeys).Select(c => c.Name).ToArray();

        static int Compare(object? x, object? y)
        {
            if (x is null || y is null) return (x is null ? 0 : 1) - (y is null ? 0 : 1);
            if (x is IComparable cx && y.GetType() == x.GetType() && x is not string) return cx.CompareTo(y);
            return string.Compare(Convert.ToString(x), Convert.ToString(y), StringComparison.OrdinalIgnoreCase);
        }

        // List.Sort is not stable, so ties keep their database order through the original index.
        return list.Select((row, index) => (row, index))
            .OrderBy(t => t, Comparer<(MsiGridRow row, int index)>.Create((l, r) =>
            {
                foreach (var key in keys)
                {
                    int c = Compare(l.row.Values.GetValueOrDefault(key), r.row.Values.GetValueOrDefault(key));
                    if (c != 0) return c;
                }
                return l.index.CompareTo(r.index);
            }))
            .Select(t => t.row)
            .ToList();
    }

    private void SelectTable(string tableName, bool keepFind = false)
    {
        // Choosing a table by hand, or reloading one after an edit, ends the current search.
        if (!keepFind) ResetFind();

        try
        {
            if (_selectedTable != tableName) _hexColumns.Clear(); // the hex view belongs to one table
            _selectedTable = tableName;
            _tableData = null;

            var columns = MsiService.GetTableColumns(tableName);
            var rows = MsiService.GetTableRows(tableName);
            _tableData = (columns, rows);
            _selectedRow = null;
            _selection.Clear();
            _anchor = null;
            try { _definition = MsiService.GetTableDefinition(tableName); }
            catch { _definition = null; } // e.g. system tables the editor cannot describe
            _gridRows = SortByPrimaryKey(rows.Select(r => new MsiGridRow(r)), _definition);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading table: {ex.Message}");
            _selectedTable = null;
            _tableData = null;
        }
    }

    public void Dispose() => MsiService.StateChanged -= OnMsiStateChanged;
